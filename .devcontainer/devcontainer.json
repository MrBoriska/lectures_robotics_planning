{
  "name": "Robotics Motion Planning Lectures (Marp)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "node",
  "customizations": {
    "vscode": {
      "extensions": [
        "marp-team.marp-vscode",
        "esbenp.prettier-vscode",
        "davidanson.vscode-markdownlint",
        "streetsidesoftware.code-spell-checker",
        "streetsidesoftware.code-spell-checker-russian"
      ],
      "settings": {
        "markdown.marp.themes": [
          "themes/robotics-minimal.css"
        ],
        "markdown.marp.html": "all",
        "markdown.marp.enableHtml": true,
        "markdown.marp.outlineExtension": true,
        "markdown.marp.strictPath": false,
        "markdown.marp.engine": "./scripts/marp-engine.cjs",
        "markdown.preview.openMarkdownLinks": "inEditor",
        "task.allowAutomaticTasks": "on",
        "editor.wordWrap": "on",
        "editor.formatOnSave": true,
        "files.eol": "\n"
      }
    }
  },
  "forwardPorts": [8080, 5599, 5500, 37717],
  "portsAttributes": {
    "8080": {
      "label": "Course Web Portal",
      "onAutoForward": "openBrowser"
    },
    "5599": {
      "label": "Interactive Widgets Server",
      "onAutoForward": "silent"
    },
    "5500": {
      "label": "Live Server (Interactive Widgets)",
      "onAutoForward": "silent"
    },
    "37717": {
      "label": "Marp Live Server",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "npm install",
  "postStartCommand": "node scripts/ensure-widgets-server.mjs"
}
