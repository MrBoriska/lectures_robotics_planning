# Dependencies
node_modules/
# package-lock.json is intentionally committed: `actions/setup-node` with
# cache: 'npm' fails without it, and `npm ci` needs it for reproducible builds.

# Build output
dist/
build/
out/
.cache/

# Temporary and local files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS specific files
.DS_Store
Thumbs.db

# VS Code specific
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json

# Python
__pycache__/
*.py[cod]
